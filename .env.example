# ---------------------------------------------------------------------------
# Backend environment
# Copy to .env for local development. On Render set these as environment
# variables instead of committing them.
# ---------------------------------------------------------------------------

OMDB_API_KEY=your_omdb_api_key
YOUTUBE_API_KEY=your_youtube_api_key

# PostgreSQL (Neon free tier, Supabase, Railway, or local docker-compose).
# Uncomment and fill in. If unset, the app falls back to sqlite:///movieflix.db.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# Set to false to skip YouTube trailer lookups
ENABLE_TRAILERS=true
